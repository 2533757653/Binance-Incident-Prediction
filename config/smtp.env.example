# Horizon-Incident SMTP 邮件通知配置
# 用法（开机自启时把这些 export 到环境变量，或者用 setx 永久写入 Windows）：
#   setx SMTP_SERVER "smtp.qq.com:465"
#   setx SMTP_SSL "true"
#   setx SMTP_EMAIL "your_email@qq.com"
#   setx SMTP_PASSWORD "<你的 QQ 邮箱授权码>"
#   setx SMTP_TO "your_email@qq.com"   # 收件人，默认同 SMTP_EMAIL
#
# ⚠️ 千万不要把 SMTP_PASSWORD commit 到 git！使用 setx 或 PowerShell 写到 Windows 用户环境变量。

SMTP_SERVER=smtp.qq.com:465
SMTP_SSL=true
SMTP_EMAIL=your_email@qq.com
SMTP_PASSWORD=REPLACE_WITH_QQ_AUTH_CODE
SMTP_TO=your_email@qq.com